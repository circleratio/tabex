#include <winver.h>

1 ICON "@RES_DIR@/tabex.ico"
1 24 "@RES_DIR@/tabex.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @VER_COMMA@
PRODUCTVERSION  @VER_COMMA@
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "tabex file manager"
            VALUE "FileVersion", "@VER@"
            VALUE "InternalName", "tabex"
            VALUE "OriginalFilename", "tabex.exe"
            VALUE "ProductName", "tabex"
            VALUE "ProductVersion", "@VER@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
